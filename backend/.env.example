# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.

# HTTP
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/gem_inventory

# Auth
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-du-dai
JWT_EXPIRES_IN=7d

# MinIO (S3-compatible, upload ảnh món hàng)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gem-inventory-photos
MINIO_PUBLIC_URL=http://localhost:9000

# CORS (client PWA/web). Danh sách phẩy, vd http://localhost:5173,https://app.example.com
# Rỗng/absent → default dev http://localhost:5173, http://localhost:4173 (Vite dev/preview).
CORS_ORIGINS=
