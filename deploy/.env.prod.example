# Sao chép thành .env.prod và điền giá trị THẬT. KHÔNG commit .env.prod.
# Sinh secret mạnh:  openssl rand -base64 32

# ---- Domain / TLS ---- (3 subdomain trỏ A-record về IP VPS)
API_DOMAIN=api.yourdomain.com
S3_DOMAIN=s3.yourdomain.com
APP_DOMAIN=app.yourdomain.com
ACME_EMAIL=you@email.com

# ---- PWA build ---- (Vite inline lúc build; phải trỏ tới API public HTTPS)
VITE_API_BASE_URL=https://api.yourdomain.com/

# ---- Postgres ----
POSTGRES_USER=omnigem
POSTGRES_PASSWORD=__ĐỔI_CHUỖI_MẠNH__
POSTGRES_DB=gem_inventory
# host = tên service "postgres" trong compose
DATABASE_URL=postgres://omnigem:__ĐỔI_CHUỖI_MẠNH__@postgres:5432/gem_inventory

# ---- Auth ----
JWT_SECRET=__ĐỔI_CHUỖI_NGẪU_NHIÊN_>=32_KÝ_TỰ__
JWT_EXPIRES_IN=7d

# ---- CORS ---- (origin của PWA được phép gọi API; nhiều origin ngăn bởi dấu phẩy)
CORS_ORIGINS=https://app.yourdomain.com

# ---- MinIO (dùng chung creds cho root & S3 client) ----
MINIO_ROOT_USER=omnigem-minio
MINIO_ROOT_PASSWORD=__ĐỔI_CHUỖI_MẠNH__
MINIO_ACCESS_KEY=omnigem-minio
MINIO_SECRET_KEY=__ĐỔI_CHUỖI_MẠNH__
MINIO_BUCKET=gem-inventory-photos
# Endpoint & public URL = hostname công khai qua Caddy (HTTPS), KHÔNG phải localhost
MINIO_ENDPOINT=https://s3.yourdomain.com
MINIO_PUBLIC_URL=https://s3.yourdomain.com

# ---- Seed user (chạy 1 lần; đổi mật khẩu thật, KHÔNG dùng owner123/trang123) ----
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=__MẬT_KHẨU_OWNER_THẬT__
SEED_STAFF_USERNAME=chi.trang
SEED_STAFF_PASSWORD=__MẬT_KHẨU_CHỊ_TRANG_THẬT__
